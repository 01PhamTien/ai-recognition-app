# Chỉ chứa giá trị mẫu, không phải secret thật
# Chạy Python trực tiếp trên Windows; Compose dùng hostname db/redis nội bộ.
DATABASE_URL=postgresql+psycopg://app:change_me@localhost:5432/ai_app
REDIS_URL=redis://localhost:16379/0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REDIS_STREAM=recognition:jobs
REDIS_GROUP=recognition-workers
JOB_LEASE_SECONDS=300
MODEL_PATH=models/mobilenetv2-7.onnx
LABELS_PATH=models/synset.txt
MODEL_VERSION=mobilenetv2-7-v1
MODEL_SHA256=c1c513582d56afceff8516c73804e484c81c6a830712ab6d682253f4a3cd042f
LABELS_SHA256=acf75ef0abe89694b19056e0796401068b459c457baa30335f240c7692857355
TOP_K=5
LOG_LEVEL=INFO

# Cấu hình Docker Compose cục bộ. change_me chỉ là mật khẩu mẫu.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
REDIS_PORT=16379
API_PORT=8000
WORKER_PORT=8001
